# ==============================================================================
# СБОРКА, КЭШ И ГЕНЕРАТОРЫ DEPENDENCIES
# ==============================================================================
# В Conan 2.x папка build/ содержит файлы тулчейна и конфигурации пакетов.
# Её категорически нельзя коммитить, так как пути внутри неё привязаны к твоей машине.
build/
workarea/
# Временный кэш компиляторов и систем сборки
.cache/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# ==============================================================================
# РЕЗУЛЬТАТЫ КОМПИЛЯЦИИ (АРТИФАКТЫ)
# ==============================================================================
# Бинарники и исполняемые файлы
*.exe
*.out
*.app

# Статические и динамические библиотеки
*.a
*.lib
*.so
*.dylib
*.dll

# Объектные файлы
*.o
*.obj
*.pch

# ==============================================================================
# НАСТРОЙКИ СРЕД РАЗРАБОТКИ (IDE)
# ==============================================================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# CLion / JetBrains
.idea/
cmake-build-*/

# Visual Studio (на случай сборки под Windows)
*.user
*.suo
*.sln
*.vcxproj
*.filters

# ==============================================================================
# СИСТЕМНЫЕ ФАЙЛЫ И ЛОГИ
# ==============================================================================
*.log
.DS_Store
Thumbs.db
